# Copy to apps/api/.env for local development. Never commit the real .env.
NODE_ENV=development
PORT=3000
# Matches deploy/docker-compose.yml (local-only throwaway password)
DATABASE_URL=postgres://splitsmart:splitsmart_dev@localhost:5432/splitsmart
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
LOG_LEVEL=info
# Public URL the browser uses (Vite dev server locally). OAuth redirects are built from it.
APP_URL=http://localhost:5173
# Optional "Sign in with Google". Create an OAuth client (type: Web application) in Google Cloud Console
# with authorised redirect URI  http://localhost:5173/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
