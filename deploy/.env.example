# Settings for deploy/docker-compose.prod.yml. Copy to deploy/.env (git-ignored) and fill in.
# Use URL-safe secrets (POSTGRES_PASSWORD goes inside a connection URL). Generate with:
#  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

POSTGRES_PASSWORD=
JWT_SECRET=

# Local production-like run: plain HTTP on http://localhost
SITE_ADDRESS=:80
APP_URL=http://localhost
# Browsers accept Secure cookies on http://localhost, so this can stay true locally too.
COOKIE_SECURE=true

# On EC2 (Phase 4) this becomes e.g.:
#   SITE_ADDRESS=13-233-10-20.sslip.io
#   APP_URL=https://13-233-10-20.sslip.io

# Optional: Sign in with Google (redirect URI = APP_URL + /api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Host ports (change if 80/443 are taken on your machine)
HTTP_PORT=80
HTTPS_PORT=443

# Image tags. Locally built by default; Phase 5+ sets these to ghcr.io/...:<git-sha>
# API_IMAGE=splitsmart-api:local
# WEB_IMAGE=splitsmart-web:local
